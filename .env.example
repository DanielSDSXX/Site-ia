# =============================================================================
# LegalMind AI — exemplo de configuração
#
# Copie para .env e ajuste. Este arquivo NUNCA deve conter chaves reais:
# ele é versionado. O .env, sim, fica fora do controle de versão.
#
# Todas as variáveis são validadas na inicialização (src/lib/env.ts). Se algo
# estiver faltando ou inválido, a aplicação falha na largada com a lista do
# que corrigir, em vez de quebrar no meio de uma requisição.
# =============================================================================

# --- Aplicação --------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000

# Mínimo de 32 caracteres. Em produção a aplicação recusa iniciar se este
# valor ainda começar com "dev-". Gere um novo com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=dev-insecure-session-secret-change-me-0123456789

# --- Banco de dados ---------------------------------------------------------
# PostgreSQL 16 com as extensões vector (pgvector >= 0.6), pg_trgm e unaccent.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/legalmind

# Usado apenas por `npm run test:integration`. Precisa ser um banco DESCARTÁVEL:
# a suíte apaga e recria o schema a cada execução.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/legalmind_test

# pgvector = busca semântica ativa. "none" desliga o índice vetorial e a busca
# passa a ser só lexical (BM25 + tsvector). Nada quebra, só fica menos preciso.
VECTOR_DRIVER=pgvector

# --- Inteligência artificial ------------------------------------------------
# AI_PROVIDER=local usa o motor extrativo determinístico embutido. Ele não
# inventa texto — extrai trechos do próprio documento — e TODA saída sua é
# rotulada na interface como "modo demonstração". É o padrão justamente para
# que a plataforma nunca aparente ter uma capacidade que não tem.
#
# Opções: anthropic | openai | google | local
AI_PROVIDER=local
# AI_MODEL=claude-sonnet-4-5-20250929
# AI_API_KEY=

# Chaves por provedor. A específica tem precedência sobre AI_API_KEY.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# Endpoints — troque apenas para usar um gateway/proxy compatível.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# OPENAI_BASE_URL=https://api.openai.com/v1
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Embeddings alimentam a busca semântica de documentos e de jurisprudência.
# Com "local" é gerado um vetor determinístico (hashing) — funciona, mas a
# qualidade da busca semântica é bem inferior à de um modelo real.
# Opções: openai | google | local
EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=

# --- Armazenamento de documentos --------------------------------------------
# Documentos nunca são servidos por URL pública. O acesso passa sempre pela
# aplicação, com verificação de sessão, organização e permissão.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.data/storage

# Chave de criptografia em repouso (AES-256-GCM), 32 bytes em base64.
# Sem ela os arquivos são gravados sem criptografia — aceitável em
# desenvolvimento, não em produção.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# STORAGE_ENCRYPTION_KEY=

# S3 / MinIO / R2 — usados quando STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# --- Upload -----------------------------------------------------------------
MAX_UPLOAD_MB=50
ALLOWED_UPLOAD_MIME=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,image/png,image/jpeg

# --- OCR --------------------------------------------------------------------
# "none" = PDFs digitalizados sem camada de texto são marcados como
# "não foi possível extrair texto" em vez de gerar conteúdo inventado.
# "tesseract" exige o binário tesseract-ocr instalado no host.
OCR_PROVIDER=none
OCR_LANG=por
OCR_MAX_PAGES=50

# --- Fila de processamento --------------------------------------------------
# A fila é tabela no Postgres (FOR UPDATE SKIP LOCKED), sem Redis.
QUEUE_DRIVER=database
# true: a própria aplicação processa os jobs. Prático em desenvolvimento.
# false: rode `npm run worker` como processo separado (recomendado em produção).
QUEUE_INLINE_WORKER=true
QUEUE_CONCURRENCY=2

# --- E-mail (convites de equipe) --------------------------------------------
# Com EMAIL_PROVIDER=none nenhum e-mail sai: o link de convite é exibido na
# própria tela para você copiar. Nada é "enviado" silenciosamente para lugar
# nenhum.
# Opções: none | resend | sendgrid | smtp
EMAIL_PROVIDER=none
EMAIL_FROM=noreply@legalmind.local
EMAIL_FROM_NAME=LegalMind AI
INVITE_BASE_URL=http://localhost:3000
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# --- CNJ DataJud (API Pública) ----------------------------------------------
# Fonte oficial do Conselho Nacional de Justiça para DADOS PROCESSUAIS:
# número, classe, assuntos, órgão julgador, grau e movimentações.
#
# Atenção ao que esta API é e ao que ela não é: o DataJud NÃO publica ementas,
# inteiro teor, relator ou tese. Por isso ele alimenta a aba "Consulta
# processual" (e a linha do tempo do processo), e não o acervo de
# jurisprudência — que exige ementa e URL verificável da fonte.
#
# A chave pública de acesso é divulgada pelo próprio CNJ em:
#   https://datajud-wiki.cnj.jus.br/api-publica/acesso
# Informe-a SEM o prefixo "APIKey" — o cliente monta o cabeçalho.
DATAJUD_ENABLED=false
# DATAJUD_API_KEY=
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br
# Índice consultado por padrão quando o usuário não escolhe o tribunal na tela.
DATAJUD_TRIBUNAL_INDEX=api_publica_tjgo

# --- Pagamentos -------------------------------------------------------------
# Dados de cartão nunca trafegam nem são armazenados pela plataforma: a
# cobrança é sempre delegada ao provedor. Com "none", a tela de plano é
# informativa e diz isso claramente.
# Opções: none | stripe | mercadopago
PAYMENT_PROVIDER=none
# PAYMENT_SECRET=
# PAYMENT_WEBHOOK_SECRET=

# --- Segurança --------------------------------------------------------------
# Rate limiting persistido no banco (login, upload, análises, chat).
# Desligue apenas em testes locais.
RATE_LIMIT_ENABLED=true
