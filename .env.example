# =============================================================================
# LegalMind AI — variáveis de ambiente
# Copie para `.env` e preencha. NUNCA versione o arquivo `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000

# Segredo usado para assinar cookies de sessão (HS256).
# Gere com: openssl rand -base64 48
SESSION_SECRET=troque-este-valor-por-um-segredo-de-no-minimo-32-caracteres

# -----------------------------------------------------------------------------
# Banco de dados (PostgreSQL 14+ com a extensão pgvector)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://legalmind:legalmind@localhost:5432/legalmind?schema=public
# Banco usado apenas por `npm run test:integration` (será limpo a cada execução)
TEST_DATABASE_URL=postgresql://legalmind:legalmind@localhost:5432/legalmind_test?schema=public

# -----------------------------------------------------------------------------
# Busca vetorial
#   pgvector -> usa a extensão `vector` (recomendado, exige CREATE EXTENSION)
#   none     -> desliga a busca vetorial; a recuperação usa apenas full-text
# -----------------------------------------------------------------------------
VECTOR_DRIVER=pgvector

# -----------------------------------------------------------------------------
# Provedor de IA (geração de texto)
#   anthropic | openai | google | local
#
#   `local` NÃO é um LLM. É um analisador extrativo determinístico embutido,
#   usado para desenvolvimento e demonstração. Todas as respostas geradas por
#   ele são marcadas na interface como "modo demonstração".
# -----------------------------------------------------------------------------
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=

# Provedor de embeddings: openai | google | local
#   `local` usa um embedding lexical determinístico (hashing + n-gramas).
#   Funciona offline, mas tem qualidade semântica inferior a um modelo real.
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Chaves específicas por provedor (opcionais; têm precedência sobre AI_API_KEY)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Endpoints (só altere para gateways compatíveis / self-hosted)
ANTHROPIC_BASE_URL=https://api.anthropic.com
OPENAI_BASE_URL=https://api.openai.com/v1
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# -----------------------------------------------------------------------------
# Armazenamento de documentos
#   local -> disco local em STORAGE_LOCAL_DIR (nunca servido estaticamente)
#   s3    -> qualquer serviço compatível com S3 (AWS S3, R2, MinIO...)
# -----------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.data/storage

S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Criptografia dos arquivos em repouso (AES-256-GCM).
# Gere com: openssl rand -hex 32   (64 caracteres hexadecimais)
# Deixe vazio para desativar (não recomendado em produção).
STORAGE_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Upload
# -----------------------------------------------------------------------------
MAX_UPLOAD_MB=50
ALLOWED_UPLOAD_MIME=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,image/png,image/jpeg

# -----------------------------------------------------------------------------
# OCR (documentos digitalizados)
#   none      -> páginas sem texto são marcadas como "requer OCR" (honesto)
#   tesseract -> usa `tesseract` instalado no sistema (apt install tesseract-ocr
#                tesseract-ocr-por) + `pdftoppm` do poppler-utils
# -----------------------------------------------------------------------------
OCR_PROVIDER=none
OCR_LANG=por
OCR_MAX_PAGES=50

# -----------------------------------------------------------------------------
# Fila de processamento assíncrono
#   database -> fila durável em PostgreSQL (padrão, não requer Redis)
# -----------------------------------------------------------------------------
QUEUE_DRIVER=database
# Quando true, a aplicação Next.js roda um worker embutido (bom para dev
# e deploys single-node). Em produção prefira `npm run worker` num processo
# separado e deixe este valor como false.
QUEUE_INLINE_WORKER=true
QUEUE_CONCURRENCY=2

# -----------------------------------------------------------------------------
# Pagamentos — INTEGRAÇÃO FUTURA
# Sem estas variáveis a plataforma opera em modo "billing manual":
# planos e assinaturas existem no banco, mas nenhuma cobrança é feita.
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=none
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
