// LegalMind AI — modelo de dados
//
// Princípios:
//  1. Multi-tenancy rígido: toda tabela de negócio carrega `organizationId`.
//  2. Rastreabilidade: todo texto analisado pela IA é ancorado em
//     Document -> DocumentPage -> DocumentChunk, e toda afirmação da IA
//     aponta para um Citation que referencia página + trecho.
//  3. Busca vetorial via pgvector. A coluna `embedding` é gerenciada por SQL
//     bruto (Prisma a declara como Unsupported e não a expõe no client).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  LAWYER
  ASSISTANT
  VIEWER
}

enum PlanTier {
  FREE
  PRO
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum ProcessStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
  CLOSED
}

enum RiskLevel {
  UNKNOWN
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PartyRole {
  PLAINTIFF
  DEFENDANT
  THIRD_PARTY
  PROSECUTOR
  JUDGE
  LAWYER
  EXPERT
  WITNESS
  OTHER
}

enum PartySide {
  OURS
  OPPOSING
  NEUTRAL
}

enum ClientType {
  INDIVIDUAL
  COMPANY
}

enum DocumentKind {
  INITIAL_PETITION
  ANSWER
  REPLY
  DECISION
  SENTENCE
  APPEAL
  EVIDENCE
  EXPERT_REPORT
  HEARING_MINUTES
  CONTRACT
  POWER_OF_ATTORNEY
  OTHER
  UNKNOWN
}

enum DocumentStatus {
  PENDING
  EXTRACTING
  NEEDS_OCR
  CHUNKING
  EMBEDDING
  INDEXED
  FAILED
}

enum SourceType {
  UPLOAD
  MANUAL
  INTEGRATION
  DEMO
}

enum ExtractionMethod {
  NATIVE_TEXT
  OCR
  PLAIN_TEXT
  DOCX
  NONE
}

enum ClaimKind {
  FACT
  ALLEGATION
  REQUEST
  THESIS
  DEFENSE
}

enum EvidenceStrength {
  NONE
  WEAK
  MODERATE
  STRONG
}

enum AnalysisType {
  PROCESS_SUMMARY
  TIMELINE
  VULNERABILITIES
  ADVERSARIAL
  TRIAL_SIMULATION
  CONTRADICTIONS
  NEXT_ACTIONS
  EVIDENCE_MAP
  CLIENT_EXPLANATION
  STRUCTURE_EXTRACTION
}

enum AnalysisStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum Confidence {
  LOW
  MEDIUM
  HIGH
}

enum Severity {
  LOW
  MEDIUM
  HIGH
}

enum FindingType {
  VULNERABILITY
  CONTRADICTION
  ADVERSARIAL_ARGUMENT
  COUNTER_ARGUMENT
  STRATEGIC_ACTION
  TRIAL_POINT_PLAINTIFF
  TRIAL_POINT_DEFENDANT
  CONTROVERSIAL_ISSUE
  EVIDENCE_GAP
}

enum FindingStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  WAITING
  DONE
  CANCELED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DeadlineStatus {
  OPEN
  DONE
  MISSED
  CANCELED
}

enum DeadlineCountingMode {
  BUSINESS_DAYS
  CALENDAR_DAYS
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum NotificationKind {
  DOCUMENT_PROCESSED
  ANALYSIS_COMPLETED
  DEADLINE_APPROACHING
  HIGH_RISK_DETECTED
  NEW_MOVEMENT
  TASK_ASSIGNED
  SYSTEM
}

enum AIOperation {
  EMBEDDING
  CHAT
  SUMMARY
  VULNERABILITIES
  ADVERSARIAL
  TRIAL_SIMULATION
  CONTRADICTIONS
  NEXT_ACTIONS
  EVIDENCE_MAP
  CLIENT_EXPLANATION
  STRUCTURE_EXTRACTION
  OCR
  JURISPRUDENCE_SEARCH
  REPORT
}

enum CreditReason {
  SUBSCRIPTION_GRANT
  MANUAL_GRANT
  CONSUMPTION
  REFUND
}

enum MemoryKind {
  TEMPLATE
  THESIS
  BRIEF
  FAVORABLE_DECISION
  PREFERRED_JURISPRUDENCE
  STYLE_GUIDE
  STRATEGY
  INTERNAL_KNOWLEDGE
}

// ---------------------------------------------------------------------------
// Identidade, organização e billing
// ---------------------------------------------------------------------------

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  passwordHash      String
  avatarColor       String    @default("#5B67F1")
  isPlatformAdmin   Boolean   @default(false)
  emailVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  memberships       Membership[]
  sessions          Session[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  createdProcesses  Process[]         @relation("ProcessCreatedBy")
  responsibleFor    Process[]         @relation("ProcessResponsible")
  uploadedDocuments Document[]
  assignedTasks     Task[]            @relation("TaskAssignee")
  createdTasks      Task[]            @relation("TaskCreatedBy")
  deadlines         Deadline[]
  analyses          AIAnalysis[]
  aiUsage           AIUsage[]
  chatThreads       ChatThread[]

  @@index([email])
  @@map("users")
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  organizationId String?
  tokenHash      String   @unique
  userAgent      String?
  ipHash         String?
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime @default(now())
  lastSeenAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  documentId   String? // CNPJ do escritório (opcional)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  // Configurações de privacidade / IA
  allowExternalTraining Boolean @default(false)
  aiProviderOverride    String?
  timezone              String  @default("America/Sao_Paulo")

  memberships    Membership[]
  subscription   Subscription?
  clients        Client[]
  processes      Process[]
  documents      Document[]
  tasks          Task[]
  deadlines      Deadline[]
  analyses       AIAnalysis[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  aiUsage        AIUsage[]
  creditEntries  CreditLedgerEntry[]
  memoryItems    OrgMemoryItem[]
  jurisprudence  Jurisprudence[]
  jobs           Job[]
  chatThreads    ChatThread[]
  invites        Invite[]

  @@map("organizations")
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role     @default(LAWYER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

model Invite {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  role           Role     @default(LAWYER)
  tokenHash      String   @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@map("invites")
}

model Plan {
  id                String   @id @default(cuid())
  tier              PlanTier @unique
  name              String
  description       String
  monthlyPriceCents Int      @default(0)
  currency          String   @default("BRL")
  maxProcesses      Int // -1 = ilimitado
  maxUsers          Int
  maxDocumentsMonth Int
  monthlyCredits    Int
  maxStorageMb      Int
  features          Json     @default("[]")
  externalPriceId   String? // ID do preço no provedor de pagamento
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String             @unique
  planId               String
  status               SubscriptionStatus @default(TRIALING)
  provider             String             @default("none") // stripe | mercadopago | none
  externalCustomerId   String?
  externalSubscriptionId String?
  currentPeriodStart   DateTime           @default(now())
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

model CreditLedgerEntry {
  id             String       @id @default(cuid())
  organizationId String
  amount         Int // positivo = crédito, negativo = consumo
  balanceAfter   Int
  reason         CreditReason
  operation      AIOperation?
  reference      String?
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("credit_ledger_entries")
}

// ---------------------------------------------------------------------------
// Núcleo jurídico
// ---------------------------------------------------------------------------

model Client {
  id             String     @id @default(cuid())
  organizationId String
  name           String
  type           ClientType @default(INDIVIDUAL)
  email          String?
  phone          String?
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  processes    Process[]

  @@index([organizationId, name])
  @@map("clients")
}

model Process {
  id             String        @id @default(cuid())
  organizationId String
  number         String // número CNJ
  court          String? // tribunal
  district       String? // comarca
  courtUnit      String? // vara
  procedureClass String? // classe
  subject        String? // assunto
  status         ProcessStatus @default(ACTIVE)
  caseValueCents BigInt?
  notes          String?
  clientId       String?
  responsibleId  String?
  createdById    String?
  sourceType     SourceType    @default(MANUAL)
  isDemo         Boolean       @default(false)

  // Estado da inteligência (preenchido por análises, nunca escrito à mão)
  riskLevel          RiskLevel @default(UNKNOWN)
  riskScore          Int? // 0-100
  riskRationale      String?
  executiveSummary   String?
  currentSituation   String?
  probableNextStep   String?
  lastAnalyzedAt     DateTime?
  lastMovementAt     DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client        Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  responsible   User?           @relation("ProcessResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  createdBy     User?           @relation("ProcessCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  parties       Party[]
  documents     Document[]
  claims        Claim[]
  evidence      Evidence[]
  arguments     Argument[]
  legalIssues   LegalIssue[]
  timeline      TimelineEvent[]
  deadlines     Deadline[]
  tasks         Task[]
  analyses      AIAnalysis[]
  findings      Finding[]
  chatThreads   ChatThread[]
  notifications Notification[]
  aiUsage       AIUsage[]
  reports       Report[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, riskLevel])
  @@map("processes")
}

model Party {
  id             String    @id @default(cuid())
  organizationId String
  processId      String
  name           String
  role           PartyRole @default(OTHER)
  side           PartySide @default(NEUTRAL)
  documentId     String? // CPF/CNPJ — armazenado apenas se informado
  lawyerName     String?
  oabNumber      String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  process Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([processId])
  @@index([organizationId, name])
  @@map("parties")
}

// ---------------------------------------------------------------------------
// Documentos: Document -> DocumentPage -> DocumentChunk
// ---------------------------------------------------------------------------

model Document {
  id               String           @id @default(cuid())
  organizationId   String
  processId        String?
  uploadedById     String?
  title            String
  originalFilename String
  mimeType         String
  sizeBytes        Int
  sha256           String
  storageKey       String
  kind             DocumentKind     @default(UNKNOWN)
  status           DocumentStatus   @default(PENDING)
  sourceType       SourceType       @default(UPLOAD)
  extractionMethod ExtractionMethod @default(NONE)
  pageCount        Int              @default(0)
  charCount        Int              @default(0)
  documentDate     DateTime? // data do documento, quando identificada
  language         String           @default("pt-BR")
  metadata         Json             @default("{}")
  processingError  String?
  processedAt      DateTime?
  isDemo           Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  process      Process?        @relation(fields: [processId], references: [id], onDelete: Cascade)
  uploadedBy   User?           @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  pages        DocumentPage[]
  chunks       DocumentChunk[]
  citations    Citation[]
  evidence     Evidence[]
  timeline     TimelineEvent[]

  @@index([organizationId, processId])
  @@index([organizationId, sha256])
  @@map("documents")
}

model DocumentPage {
  id         String   @id @default(cuid())
  documentId String
  pageNumber Int
  text       String
  charCount  Int      @default(0)
  needsOcr   Boolean  @default(false)
  ocrApplied Boolean  @default(false)
  createdAt  DateTime @default(now())

  document  Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunks    DocumentChunk[]
  citations Citation[]

  @@unique([documentId, pageNumber])
  @@map("document_pages")
}

model DocumentChunk {
  id             String   @id @default(cuid())
  organizationId String
  processId      String?
  documentId     String
  pageId         String?
  pageNumber     Int
  chunkIndex     Int
  content        String
  tokenEstimate  Int      @default(0)
  charStart      Int      @default(0)
  charEnd        Int      @default(0)
  embeddingModel String?
  embeddedAt     DateTime?
  createdAt      DateTime @default(now())

  // Gerenciados por SQL bruto (ver prisma/migrations e src/lib/rag/vector-store.ts)
  embedding      Unsupported("vector(1536)")?
  searchVector   Unsupported("tsvector")?

  document Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  page     DocumentPage? @relation(fields: [pageId], references: [id], onDelete: SetNull)
  citations Citation[]

  @@unique([documentId, chunkIndex])
  @@index([organizationId, processId])
  @@map("document_chunks")
}

// ---------------------------------------------------------------------------
// Grafo do processo: fatos, provas, teses, argumentos, pedidos
// ---------------------------------------------------------------------------

model Claim {
  id             String    @id @default(cuid())
  organizationId String
  processId      String
  kind           ClaimKind @default(ALLEGATION)
  text           String
  raisedBySide   PartySide @default(NEUTRAL)
  isDisputed     Boolean   @default(false)
  evidenceStrength EvidenceStrength @default(NONE)
  strengthRationale String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  process   Process    @relation(fields: [processId], references: [id], onDelete: Cascade)
  evidence  Evidence[]
  citations Citation[]
  arguments Argument[]

  @@index([processId, kind])
  @@map("claims")
}

model Evidence {
  id             String           @id @default(cuid())
  organizationId String
  processId      String
  claimId        String?
  documentId     String?
  pageNumber     Int?
  title          String
  description    String?
  strength       EvidenceStrength @default(MODERATE)
  supports       Boolean          @default(true) // false = contradiz a alegação
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  process  Process   @relation(fields: [processId], references: [id], onDelete: Cascade)
  claim    Claim?    @relation(fields: [claimId], references: [id], onDelete: SetNull)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([processId])
  @@map("evidence")
}

model LegalIssue {
  id             String   @id @default(cuid())
  organizationId String
  processId      String
  title          String
  description    String?
  isControversial Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  process   Process    @relation(fields: [processId], references: [id], onDelete: Cascade)
  arguments Argument[]

  @@index([processId])
  @@map("legal_issues")
}

model Argument {
  id             String     @id @default(cuid())
  organizationId String
  processId      String
  legalIssueId   String?
  claimId        String?
  side           PartySide  @default(OURS)
  text           String
  legalBasis     String?
  strength       Severity   @default(MEDIUM)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  process    Process     @relation(fields: [processId], references: [id], onDelete: Cascade)
  legalIssue LegalIssue? @relation(fields: [legalIssueId], references: [id], onDelete: SetNull)
  claim      Claim?      @relation(fields: [claimId], references: [id], onDelete: SetNull)
  citations  Citation[]

  @@index([processId, side])
  @@map("arguments")
}

model TimelineEvent {
  id             String   @id @default(cuid())
  organizationId String
  processId      String
  occurredAt     DateTime
  type           String // Distribuição, Citação, Contestação, ...
  title          String
  description    String?
  documentId     String?
  pageNumber     Int?
  importance     Severity @default(MEDIUM)
  isInferred     Boolean  @default(false)
  createdAt      DateTime @default(now())

  process  Process   @relation(fields: [processId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([processId, occurredAt])
  @@map("timeline_events")
}

// ---------------------------------------------------------------------------
// Inteligência: análises, achados, citações, chat
// ---------------------------------------------------------------------------

model AIAnalysis {
  id             String         @id @default(cuid())
  organizationId String
  processId      String
  requestedById  String?
  type           AnalysisType
  status         AnalysisStatus @default(QUEUED)
  confidence     Confidence?
  summary        String?
  result         Json           @default("{}")
  provider       String?
  model          String?
  chunkIdsUsed   String[]       @default([])
  error          String?
  startedAt      DateTime?
  completedAt    DateTime?
  durationMs     Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  process      Process      @relation(fields: [processId], references: [id], onDelete: Cascade)
  requestedBy  User?        @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  findings     Finding[]
  citations    Citation[]

  @@index([processId, type, createdAt])
  @@map("ai_analyses")
}

model Finding {
  id             String        @id @default(cuid())
  organizationId String
  processId      String
  analysisId     String?
  type           FindingType
  title          String
  description    String
  rationale      String? // "por que isso importa"
  suggestion     String? // "o que poderia ser feito"
  severity       Severity      @default(MEDIUM)
  confidence     Confidence    @default(MEDIUM)
  status         FindingStatus @default(OPEN)
  position       Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  process   Process     @relation(fields: [processId], references: [id], onDelete: Cascade)
  analysis  AIAnalysis? @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  citations Citation[]

  @@index([processId, type])
  @@map("findings")
}

/// Uma citação é o elo entre uma afirmação da IA e o texto de origem.
/// Sem Citation, nenhuma afirmação factual pode ser exibida como documentada.
model Citation {
  id             String   @id @default(cuid())
  organizationId String
  documentId     String?
  pageId         String?
  chunkId        String?
  pageNumber     Int?
  quote          String // trecho literal recuperado do documento
  analysisId     String?
  findingId      String?
  messageId      String?
  argumentId     String?
  claimId        String?
  jurisprudenceId String?
  relevance      Float    @default(0)
  createdAt      DateTime @default(now())

  document      Document?      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  page          DocumentPage?  @relation(fields: [pageId], references: [id], onDelete: SetNull)
  chunk         DocumentChunk? @relation(fields: [chunkId], references: [id], onDelete: SetNull)
  analysis      AIAnalysis?    @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  finding       Finding?       @relation(fields: [findingId], references: [id], onDelete: Cascade)
  message       AIMessage?     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  argument      Argument?      @relation(fields: [argumentId], references: [id], onDelete: Cascade)
  claim         Claim?         @relation(fields: [claimId], references: [id], onDelete: Cascade)
  jurisprudence Jurisprudence? @relation(fields: [jurisprudenceId], references: [id], onDelete: SetNull)

  @@index([analysisId])
  @@index([findingId])
  @@index([messageId])
  @@map("citations")
}

model ChatThread {
  id             String   @id @default(cuid())
  organizationId String
  processId      String
  userId         String
  title          String   @default("Nova conversa")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  process      Process      @relation(fields: [processId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     AIMessage[]

  @@index([processId, userId])
  @@map("chat_threads")
}

model AIMessage {
  id             String      @id @default(cuid())
  organizationId String
  threadId       String
  role           MessageRole
  content        String
  confidence     Confidence?
  provider       String?
  model          String?
  chunkIdsUsed   String[]    @default([])
  verbosity      String      @default("detailed") // short | detailed
  createdAt      DateTime    @default(now())

  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  citations Citation[]

  @@index([threadId, createdAt])
  @@map("ai_messages")
}

// ---------------------------------------------------------------------------
// Prazos, tarefas, relatórios, notificações
// ---------------------------------------------------------------------------

model Deadline {
  id             String               @id @default(cuid())
  organizationId String
  processId      String?
  title          String
  description    String?
  dueDate        DateTime
  baseDate       DateTime?
  days           Int?
  countingMode   DeadlineCountingMode @default(BUSINESS_DAYS)
  legalBasis     String?
  status         DeadlineStatus       @default(OPEN)
  priority       Priority             @default(MEDIUM)
  responsibleId  String?
  computed       Boolean              @default(false)
  computationNote String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  process      Process?     @relation(fields: [processId], references: [id], onDelete: Cascade)
  responsible  User?        @relation(fields: [responsibleId], references: [id], onDelete: SetNull)

  @@index([organizationId, dueDate, status])
  @@map("deadlines")
}

model Task {
  id             String     @id @default(cuid())
  organizationId String
  processId      String?
  title          String
  description    String?
  status         TaskStatus @default(TODO)
  priority       Priority   @default(MEDIUM)
  dueDate        DateTime?
  assigneeId     String?
  createdById    String?
  originFindingId String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  completedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  process      Process?     @relation(fields: [processId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, dueDate])
  @@map("tasks")
}

model Report {
  id             String   @id @default(cuid())
  organizationId String
  processId      String
  type           String // executive | client | internal | risk | full
  format         String // pdf | docx
  title          String
  storageKey     String
  sizeBytes      Int      @default(0)
  generatedById  String?
  createdAt      DateTime @default(now())

  process Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([processId, createdAt])
  @@map("reports")
}

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  processId      String?
  kind           NotificationKind
  title          String
  body           String?
  href           String?
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  process      Process?     @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Jurisprudência e memória do escritório
// ---------------------------------------------------------------------------

/// Jurisprudência só existe no sistema quando importada de uma fonte
/// identificável. `sourceUrl` + `verified` impedem que a IA apresente
/// decisões não verificáveis como reais.
model Jurisprudence {
  id             String   @id @default(cuid())
  organizationId String?  // null = acervo compartilhado da plataforma
  court          String
  judgingBody    String?
  caseNumber     String
  judgmentDate   DateTime?
  reporter       String? // relator
  summary        String // ementa
  thesis         String?
  outcome        String?
  excerpt        String?
  sourceUrl      String?
  sourceName     String
  verified       Boolean  @default(false)
  isDemo         Boolean  @default(false)
  embeddingModel String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  embedding Unsupported("vector(1536)")?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  citations    Citation[]

  @@index([organizationId, court])
  @@map("jurisprudence")
}

model OrgMemoryItem {
  id             String     @id @default(cuid())
  organizationId String
  kind           MemoryKind
  title          String
  content        String
  tags           String[]   @default([])
  enabled        Boolean    @default(true)
  embeddingModel String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  embedding Unsupported("vector(1536)")?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, kind])
  @@map("org_memory_items")
}

// ---------------------------------------------------------------------------
// Infraestrutura: fila, uso de IA, auditoria
// ---------------------------------------------------------------------------

model Job {
  id             String    @id @default(cuid())
  organizationId String?
  type           String
  payload        Json      @default("{}")
  status         JobStatus @default(QUEUED)
  priority       Int       @default(0)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  runAt          DateTime  @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  progress       Int       @default(0)
  progressLabel  String?
  lastError      String?
  result         Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  completedAt    DateTime?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, runAt, priority])
  @@index([organizationId, createdAt])
  @@map("jobs")
}

model AIUsage {
  id              String      @id @default(cuid())
  organizationId  String
  userId          String?
  processId       String?
  operation       AIOperation
  provider        String
  model           String
  inputTokens     Int         @default(0)
  outputTokens    Int         @default(0)
  estimatedCostUsd Float      @default(0)
  creditsCharged  Int         @default(0)
  durationMs      Int         @default(0)
  success         Boolean     @default(true)
  createdAt       DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  process      Process?     @relation(fields: [processId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([createdAt])
  @@map("ai_usage")
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  action         String // auth.login, document.upload, process.delete, ...
  resourceType   String?
  resourceId     String?
  ipHash         String?
  userAgent      String?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}
